# Supabase de DossierInmobiliario. La API solo lee. Es la misma clave que usa
# la web de Semáforo (SUPABASE_SERVICE_KEY): va solo en el servidor, nunca en la app.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_clave

# Solo para construir la imagen: lectura del repo privado DossierInmobiliario.
GITHUB_TOKEN=

# Opcionales (valores por defecto entre paréntesis)
# DIAS_VIGENCIA=7
# CREDITO_PIE_PCT=10
# CREDITO_PLAZO_ANOS=30
# CREDITO_TASA_PCT=4.0
# HORAS_ALERTA=48
# DOSSIER_PATH=vendor/dossier
